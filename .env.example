PORT=3000
DB_HOST=db
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=web_app
DB_PORT=3306
# API Key de Google Gemini (Dejar vacío para usar motor local Tesseract/Poppler como fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Configuración SMTP para Envío Real de Correos (100% Gratuito vía Gmail App Password o SMTP corporativo)
# Para Gmail: Activa verificación en 2 pasos en Google -> Seguridad -> Contraseñas de Aplicaciones -> Generar
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nexxo S.A. Acreditaciones <noreply@nexxo.cl>"
