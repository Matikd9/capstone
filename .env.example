PORT=3000
NODE_ENV=development

# ========================================================
# OPCIÓN A: Desarrollo Local (MySQL en Contenedor Docker)
# ========================================================
DB_HOST=db
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=web_app
DB_PORT=3306
DB_SSL=false

# ========================================================
# OPCIÓN B: Producción (TiDB Cloud / Nube)
# Configurar estas variables en el panel del proveedor (ej. Cloud Run)
# o en tu archivo .env.production local (no rastreado en Git).
# ========================================================
# DB_HOST=gateway01.sa-east-1.prod.aws.tidbcloud.com
# DB_USER=<tidb_user>
# DB_PASSWORD=<tidb_password>
# DB_NAME=web_app
# DB_PORT=4000
# DB_SSL=true

# ========================================================
# Servicios Adicionales (Gemini OCR y SMTP)
# ========================================================
# API Key de Google Gemini (Dejar vacío para usar motor local Tesseract como fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Configuración SMTP para Envío de Correos
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nexxo S.A. Acreditaciones <noreply@nexxo.cl>"

# Seguridad y Autenticación Administrativa
JWT_SECRET=dev-jwt-secret-nexxo-2026-local
ADMIN_DEFAULT_PASSWORD=papa123
