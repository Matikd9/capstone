<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 856 540" width="856" height="540" style="background:#f4f6f8; font-family: 'Arial', sans-serif;">
  <!-- Tarjeta PVC fondo con bordes redondeados -->
  <rect x="10" y="10" width="836" height="520" rx="24" fill="#ffffff" stroke="#cbd5e1" stroke-width="3" filter="drop-shadow(0 10px 15px rgba(0,0,0,0.1))"/>
  
  <!-- Franja Superior de Seguridad / Organismo -->
  <rect x="10" y="10" width="836" height="110" rx="24" fill="#0f172a"/>
  <rect x="10" y="90" width="836" height="30" fill="#f59e0b"/> <!-- Franja de advertencia/minería -->

  <!-- Título Organismo e Icono -->
  <text x="50" y="55" fill="#f8fafc" font-size="24" font-weight="bold" letter-spacing="1">INSTITUTO DE CERTIFICACIÓN TÉCNICA MINERA</text>
  <text x="50" y="82" fill="#94a3b8" font-size="14" letter-spacing="0.5">ACREDITACIÓN TÉCNICA BAJO NORMA ASME B30.5 / ASME B30.9</text>
  <text x="740" y="65" fill="#f59e0b" font-size="28" font-weight="900">ASME</text>

  <!-- Recuadro Foto Postulante -->
  <rect x="50" y="150" width="200" height="250" rx="12" fill="#e2e8f0" stroke="#94a3b8" stroke-width="2"/>
  <!-- Silueta de usuario -->
  <circle cx="150" cy="230" r="50" fill="#64748b"/>
  <path d="M 80 370 Q 150 290 220 370 Z" fill="#64748b"/>
  <text x="85" y="390" fill="#475569" font-size="13" font-weight="bold">FOTO OFICIAL</text>

  <!-- Datos Principales del Trabajador (Objetivo del OCR) -->
  <g transform="translate(280, 160)">
    <!-- Cargo y Nivel -->
    <rect x="0" y="0" width="510" height="42" rx="8" fill="#eff6ff" stroke="#bfdbfe" stroke-width="1.5"/>
    <text x="15" y="28" fill="#1e40af" font-size="20" font-weight="bold">RIGGER NIVEL 2 - IZAJES CRÍTICOS</text>

    <!-- Nombre Completo -->
    <text x="0" y="75" fill="#64748b" font-size="13" font-weight="bold">NOMBRE COMPLETO</text>
    <text x="0" y="102" fill="#0f172a" font-size="22" font-weight="bold">MATÍAS ALONSO MEDINA PAVEZ</text>

    <!-- RUT -->
    <text x="0" y="140" fill="#64748b" font-size="13" font-weight="bold">R.U.T.</text>
    <text x="0" y="165" fill="#0f172a" font-size="20" font-weight="bold">21.559.457-2</text>

    <!-- Folio / Registro -->
    <text x="280" y="140" fill="#64748b" font-size="13" font-weight="bold">N° REGISTRO ASME</text>
    <text x="280" y="165" fill="#0f172a" font-size="18" font-weight="bold">RIG-2026-9457-DET</text>

    <!-- Fechas Clave (Validación de Vigencia) -->
    <line x1="0" y1="190" x2="510" y2="190" stroke="#e2e8f0" stroke-width="2"/>
    
    <text x="0" y="220" fill="#64748b" font-size="13" font-weight="bold">FECHA EMISIÓN</text>
    <text x="0" y="245" fill="#15803d" font-size="18" font-weight="bold">15/01/2026</text>

    <text x="200" y="220" fill="#64748b" font-size="13" font-weight="bold">FECHA VENCIMIENTO</text>
    <text x="200" y="245" fill="#b91c1c" font-size="20" font-weight="bold">15/01/2028</text>

    <!-- Simulación Código QR / Verificación -->
    <rect x="420" y="200" width="80" height="80" fill="#0f172a" rx="6"/>
    <rect x="430" y="210" width="25" height="25" fill="#ffffff"/>
    <rect x="465" y="210" width="25" height="25" fill="#ffffff"/>
    <rect x="430" y="245" width="25" height="25" fill="#ffffff"/>
    <rect x="465" y="245" width="15" height="15" fill="#ffffff"/>
  </g>

  <!-- Franja Inferior con Estándares Codelco -->
  <rect x="10" y="470" width="836" height="60" rx="0" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1"/>
  <text x="50" y="505" fill="#475569" font-size="13" font-weight="bold">
    HOMOLOGADO PARA DIVISIÓN EL TENIENTE • ESTÁNDAR CONTROL FATALIDADES ECF N° 7 (IZAJES)
  </text>
</svg>
